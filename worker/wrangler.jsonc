{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mywormhole",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "R2_BUCKET_NAME": "mywormhole-transfers",
    "DIRECT_R2": "true",
    "ROOM_TTL_SECONDS": "7200",
    "MAX_FILE_BYTES": "10737418240"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TransferRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransferRoom"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mywormhole-transfers" }],
  "observability": { "enabled": false }
}
